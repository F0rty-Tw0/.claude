{
  "respectGitignore": false,
  "env": {
    "BASH_MAX_TIMEOUT_MS": "1800000",
    "CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS": "1"
  },
  "includeCoAuthoredBy": false,
  "permissions": {
    "allow": [
      "Bash(find:*)",
      "Bash(ls:*)",
      "Bash(mkdir:*)",
      "WebFetch(domain:github.com)",
      "WebFetch(domain:www.typescriptlang.org)",
      "Bash(git log:*)",
      "Bash(gh issue list:*)",
      "Bash(gh issue view:*)",
      "Bash(npx prettier:*)",
      "Bash(nx prepush:*)",
      "Bash(pnpm commit:*)",
      "Bash(rg:*)",
      "mcp__nx__nx_docs",
      "mcp__nx__nx_workspace",
      "mcp__nx__nx_project_details",
      "Bash(nx show projects:*)",
      "Bash(nx run-many:*)",
      "Bash(nx run:*)",
      "Bash(nx affected:*)",
      "Bash(nx lint:*)",
      "Bash(nx test:*)",
      "Bash(nx build:*)",
      "Bash(nx documentation:*)"
    ],
    "deny": [
      "Bash(git push origin main:*)",
      "Bash(git push origin master:*)",
      "Bash(rm -rf:*)",
      "Bash(curl:*)",
      "Bash(wget:*)"
    ]
  },
  "enableAllProjectMcpServers": true,
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node $HOME/.claude/hooks/nul-guard.js"
          },
          {
            "type": "command",
            "command": "node $HOME/.claude/hooks/rtk/rtk-rewrite.js"
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "node $HOME/.claude/hud/omc-hud.mjs"
  },
  "enabledPlugins": {
    "oh-my-claudecode@omc": true,
    "typescript-lsp@claude-plugins-official": true,
    "marksman-lsp": true,
    "eslint-lsp@omp-lsp": true
  },
  "extraKnownMarketplaces": {
    "omp-lsp": {
      "source": {
        "source": "directory",
        "path": "$HOME/.claude/marketplaces/omp-lsp"
      }
    }
  },
  "autoUpdatesChannel": "latest",
  "effortLevel": "high"
}
