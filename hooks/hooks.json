{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          { "type": "command", "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/cloud-context.js\" 0" },
          { "type": "command", "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/cloud-context.js\" 1" },
          { "type": "command", "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/cloud-context.js\" 2" },
          { "type": "command", "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/cloud-context.js\" 3" }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          { "type": "command", "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/delete-guard.js\"" }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          { "type": "command", "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/pr-proof-guard.js\"" }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          { "type": "command", "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/commit-attribution-guard.js\"" }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          { "type": "command", "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/cold-cache.js\"" }
        ]
      }
    ]
  }
}
