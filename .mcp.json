{
  "mcpServers": {
    "context7": {
      "type": "stdio",
      "command": "cmd",
      "args": ["/c", "pnpx", "@upstash/context7-mcp"],
      "env": {
        "CONTEXT7_API_KEY": "YOUR_KEY"
      }
    },
    "exa": {
      "type": "stdio",
      "command": "cmd",
      "args": [
        "/c",
        "pnpx",
        "exa-mcp-server",
        "--tools=web_search_advanced_exa,crawling_exa"
      ],
      "env": {
        "EXA_API_KEY": "YOUR_KEY"
      }
    },
    "filesystem": {
      "type": "stdio",
      "command": "cmd",
      "args": ["/c", "pnpx", "@modelcontextprotocol/server-filesystem", "D:/"],
      "env": {}
    },
    "copilot": {
      "command": "cmd",
      "args": ["/c", "pnpx", "@leonardommello/copilot-mcp-server"]
    }
  }
}
